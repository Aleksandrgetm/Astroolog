APP_ENV=development
APP_PORT=8080
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=astroolog
DB_PASSWORD=change-me-local-only
DB_NAME=astroolog
DB_SSLMODE=disable
# In production all DB_* variables must be provided by the process environment.

# Required exact HTTPS origin in production. Leave empty for local Vite development.
APP_ORIGIN=
# Optional absolute paths for media and static publishing:
MEDIA_ROOT=./storage/media
CMS_FRONTEND_DIR=../frontend
CMS_RELEASE_ROOT=../frontend/.releases
SITE_DIST_DIR=
# Set real HTTPS site origin before enabling CMS publication.
VITE_SITE_URL=
PRERENDER_API_URL=http://127.0.0.1:8080/api
