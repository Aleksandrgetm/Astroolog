{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test:i18n": "node --experimental-strip-types --test tests/i18n.test.ts",
    "test:whatsapp": "node --experimental-strip-types --test tests/whatsapp.test.ts",
    "build:client": "vue-tsc -b && vite build --mode development",
    "test:pre-admin": "node --experimental-strip-types --test tests/pre-admin.test.ts",
    "test:seo": "node scripts/test-seo.mjs",
    "test:directions": "node scripts/test-directions.mjs",
    "test:admin:publish": "node scripts/test-admin-publish.mjs",
    "test:admin": "node scripts/test-admin.mjs",
    "test:booking": "node scripts/test-booking-flow.mjs"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "axios": "^1.20.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1",
    "vuetify": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.3.11"
  }
}
